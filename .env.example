# Copy this file to .env and fill in real values. Never commit .env itself.

# SQLite is used by default so nobody needs to install a database to get started.
# Swap this for a Postgres URL later if you deploy — SQLAlchemy makes that a one-line change.
DATABASE_URL=sqlite:///./expense_tracker.db

# Generate a real secret with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
